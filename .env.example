NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Local discrete vars — OR Railway Postgres:
# DATABASE_URL=postgresql://user:pass@host:5432/railway
# DATABASE_SSL=true
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=scoutly
DATABASE_PASSWORD=scoutly
DATABASE_NAME=scoutly
DATABASE_SYNC=true

# Redis (BullMQ) — background jobs: ingesta Keepa/CI/Ad Winners + cron de waitlist.
# Local discrete vars — OR a single REDIS_URL (Railway Redis plugin gives you this):
# REDIS_URL=redis://default:password@host:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_BASIC=price_basic_xxx
STRIPE_PRICE_PRO=price_pro_xxx

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Dev: quote the value (angle brackets break unquoted .env). Prod: verified domain.
MAIL_FROM="Scout-ly <beth.t@example.com>"
# Set true locally to log emails instead of calling Resend
MAIL_DEV_LOG_ONLY=false
RESEND_API_KEY=
STRIPE_COUPON_WAITLIST=

# Amazon / Keepa (V1 prioritario)
KEEPA_API_KEY=tuu39rd4hgbj02kc34epvfnb1kkbq05bj3kvdabousoba4rqgjo542886mndc1e2
AMAZON_PROVIDER=keepa
KEEPA_MARKETS=ES,US,MX,UK
KEEPA_PRODUCTS_PER_CATEGORY=15
# ~20 categorías allowlist × este tope. Bajar a 10 si faltan tokens Keepa.

# Creative Intelligence — PipiAds (TikTok + Meta unificado)
PIPIADS_API_KEY=
PIPIADS_BASE_URL=https://www.pipispy.com
CREATIVE_PROVIDER=auto
CI_SNAPSHOT_TOP_N=60
CI_SEARCH_RESULTS=8
CI_DETAIL_COUNT=0

# Ad Winners — vía TikTok/Meta independiente (PipiAds seeds). AD_WINNERS_ENABLED=0 para off.
AD_WINNERS_ENABLED=1
AD_WINNER_SEEDS=portable blender,neck massager,led strip lights,posture corrector,pet hair remover,mini projector,foam roller,cleaning gel

# Alibaba Open Platform (opcional, no usado en V1)
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=

# AliExpress spike (RapidAPI proxy) — live prices by keyword search
# Subscribe: https://rapidapi.com/georgekhananaev/api/aliexpress-true-api
ALIEXPRESS_RAPIDAPI_KEY=
# ALIEXPRESS_RAPIDAPI_HOST=aliexpress-true-api.p.rapidapi.com

# Alibaba.com live (RapidAPI Otapi Alibaba)
# https://rapidapi.com/open-trade-commerce-open-trade-commerce-default/api/otapi-alibaba
ALIBABA_COM_RAPIDAPI_KEY=
ALIBABA_COM_RAPIDAPI_HOST=otapi-alibaba.p.rapidapi.com
ALIBABA_COM_MAX_CALLS_PER_RUN=40

ADMIN_EMAILS=admin@scoutly.dev

SEED_DEV_USERS=true
DEV_ADMIN_EMAIL=admin@scoutly.dev
DEV_ADMIN_PASSWORD=Admin123!
DEV_USER_EMAIL=user@scoutly.dev
DEV_USER_PASSWORD=User123!
DEV_USER_PLAN=pro
