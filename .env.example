NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Local discrete vars — OR Railway Postgres:
# DATABASE_URL=postgresql://user:pass@host:5432/railway
# DATABASE_SSL=true
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=scoutly
DATABASE_PASSWORD=scoutly
DATABASE_NAME=scoutly
DATABASE_SYNC=true

# Redis (BullMQ) — background jobs: snapshot semanal PipiAds + cron de waitlist.
# Local discrete vars — OR a single REDIS_URL (Railway Redis plugin gives you this):
# REDIS_URL=redis://default:password@host:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Recurring prices: Basic 59,99 € every 6 months, Pro 99,99 € every 12 months.
STRIPE_PRICE_BASIC=price_basic_xxx
STRIPE_PRICE_PRO=price_pro_xxx

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Dev: quote the value (angle brackets break unquoted .env). Prod: verified domain.
MAIL_FROM="Scout-ly <beth.t@example.com>"
# Set true locally to log emails instead of calling Resend
MAIL_DEV_LOG_ONLY=false
RESEND_API_KEY=
STRIPE_COUPON_WAITLIST=

# Snapshot semanal ads-first: PipiAds (TikTok + Meta) es la fuente de verdad.
# Anuncios de tiendas → filtro dropshipping → PVP de la tienda (Shopify
# products.json) → coste en CJ/AliExpress → Trend Score → rankings.
PIPIADS_API_KEY=
PIPIADS_BASE_URL=https://www.pipispy.com
CREATIVE_PROVIDER=auto
# Créditos por run. 1 crédito por anuncio listado y 1 por detalle. Reparto:
# 60% escaneo, 30% detalle, 10% reserva. Se limita solo al saldo real de la
# cuenta. Techo bajado de 4000 a 1000: la caché (PIPIADS_CACHE_TTL_*) y el
# filtro OpenAI pre-detail (OPENAI_API_KEY) existen para que ~1000 alcance.
PIPIADS_WEEKLY_CREDITS=1000
# Caché de adspy/list y adspy/detail (vía Redis/ioredis, ya conectado para
# BullMQ) — evita re-pagar la misma query dentro de la ventana TTL.
PIPIADS_CACHE_TTL_LIST_SEC=21600
PIPIADS_CACHE_TTL_DETAIL_SEC=604800

# OpenAI — filtro barato antes de gastar un crédito de adspy/detail: descarta
# apps/marcas/duplicados obvios que el filtro regex no agarra. Opcional: sin
# key, el discovery sigue igual que hoy (solo el filtro regex).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Fallback con IA (Responses API, tool web_search real — nunca inventa: solo
# usa URLs que el modelo citó de una búsqueda real).
# Proveedor: corre siempre que CJ no venga acompañado de OTRA fuente live
# (AliExpress o la IA misma) — CJ solo no alcanza, queremos comparar precio.
# En la ingesta masiva, la segunda opinión de precio se dispara de a
# AI_SUPPLIER_BATCH_SIZE productos en paralelo (cada uno con su propia
# búsqueda real e independiente — antes se empaquetaban varios productos en
# un solo prompt, pero en producción el modelo a veces buscaba uno de verdad
# e inventaba una URL con pinta real para los demás del mismo prompt; el
# chequeo de citación los descartaba, pero tapaba resultados reales). El
# costo del tool call es por búsqueda, no por request, así que correr una
# búsqueda por producto no cambia lo que se paga — ver INTEGRATIONS.md 3.2.
# Ads: solo corre si PipiAds trajo <2 anuncios reales para el producto. Si la
# IA tampoco encuentra nada verificable, no se muestra nada (como hoy).
# Precio real de OpenAI (confirmado en su pricing page): $10 por 1000
# llamadas de búsqueda + tokens de contenido al precio del modelo — por eso
# default a gpt-4o-mini acá, no al modelo grande que se usa para otras cosas.
AI_SUPPLIER_FALLBACK_ENABLED=true
AI_SUPPLIER_BATCH_SIZE=3
AI_ADS_FALLBACK_ENABLED=true
OPENAI_WEB_SEARCH_MODEL=gpt-4o-mini
OPENAI_WEB_SEARCH_CONTEXT_SIZE=low
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Segunda validación de producto: antes de mostrar un listado live de CJ/
# AliExpress, le pedimos al modelo que confirme que es el MISMO producto (no
# solo que compartió palabras clave — ver offer-relevance.ts). Es un Chat
# Completion normal (completeJson), sin tool web_search, así que no paga el
# fee de $10/1000 búsquedas — solo tokens de texto, prácticamente gratis.
AI_SUPPLIER_MATCH_VALIDATION_ENABLED=true
# El catálogo es global: un solo run que busca anuncios en estas regiones.
DISCOVERY_REGIONS=US,GB,CA,AU,ES,DE,FR,IT
# País destino para el envío de CJ/AliExpress y el margen.
SHIP_TO_COUNTRY=ES
# Productos guardados en el snapshot (máx. 200); el admin lo puede cambiar por run.
DISCOVERY_PRODUCTS_TARGET=100
# Banda de PVP de compra por impulso, en EUR.
DISCOVERY_MIN_PRICE_EUR=12
DISCOVERY_MAX_PRICE_EUR=90
DISCOVERY_SHOP_TYPES=shopify,woocommerce,shoplazza,shopline,shopyy
STORE_SCRAPE_TIMEOUT_MS=5000
STORE_SCRAPE_CONCURRENCY=4
# Tipos de cambio a EUR (opcional; hay defaults estáticos). Ej.:
# FX_USD_EUR=0.92
# FX_GBP_EUR=1.17

# CJdropshipping API 2.0 — proveedor principal (coste + envío real).
# API key en cjdropshipping.com → My CJ → Authorization → API. Formato
# CJUserNum@api@xxxx. Alternativa: CJ_ACCESS_TOKEN ya emitido (~180 días).
# Cuentas gratis: 1000 requests/día y ~1 req/s.
CJ_API_KEY=
# CJ_ACCESS_TOKEN=
CJ_RPS=1

# AliExpress Business API (RapidAPI) — segundo proveedor:
# precio/volumen live por keyword (textsearch.php) y búsqueda por imagen.
# Subscribe: https://rapidapi.com/taobaobusiness-aliexpress-support/api/aliexpress-business-api
ALIEXPRESS_RAPIDAPI_KEY=
# ALIEXPRESS_RAPIDAPI_HOST=aliexpress-business-api.p.rapidapi.com
# Pedidos/segundo — sin esto, llamadas concurrentes (keyword+imagen por
# producto, varios productos a la vez en una ingesta) revientan el límite del
# plan RapidAPI y vuelven 429 Too Many Requests todo el tiempo. Bajalo si tu
# plan es más chico.
ALIEXPRESS_RPS=2

# Keepa desactivado: no se llama aunque haya key. KEEPA_ENABLED=1 para reactivarlo
# (análisis por ASIN/URL).
KEEPA_ENABLED=0
KEEPA_API_KEY=
AMAZON_PROVIDER=keepa

ADMIN_EMAILS=admin@scoutly.dev

SEED_DEV_USERS=true
DEV_ADMIN_EMAIL=admin@scoutly.dev
DEV_ADMIN_PASSWORD=Admin123!
DEV_USER_EMAIL=user@scoutly.dev
DEV_USER_PASSWORD=User123!
DEV_USER_PLAN=pro
